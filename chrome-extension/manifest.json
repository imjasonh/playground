{
  "manifest_version": 3,
  "name": "Close Duplicate Tabs",
  "version": "0.1.4",
  "description": "Closes tabs that share a URL, plans tab groups with Chrome's on-device AI, and copies decoded base64. The badge counts duplicates.",
  "permissions": [
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "offscreen",
    "sessions",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "side_panel": {
    "default_path": "insights.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selection.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Close duplicate tabs",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
