{
  "manifest_version": 3,
  "name": "Close Duplicate Tabs",
  "version": "0.1.3",
  "description": "Closes extra tabs that share a URL. The badge shows that count. Selected base64 adds a menu item that copies the decoded text.",
  "permissions": ["clipboardWrite", "contextMenus", "offscreen", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selection.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Close duplicate tabs",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
