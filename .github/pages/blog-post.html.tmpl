<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap">
<style>
__SHARED_CSS__
  article header {
    margin-bottom: 2.4rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .body {
    overflow-wrap: break-word;
    hanging-punctuation: first;
    hyphens: auto;
  }
  .body > *:first-child { margin-top: 0; }
  .body h2, .body h3, .body h4 {
    font-optical-sizing: auto;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.22;
    text-wrap: balance;
    margin: 2.15em 0 0.55em;
  }
  .body h2 { font-size: 1.42em; }
  .body h3 { font-size: 1.2em; }
  .body h4 { font-size: 1.08em; }
  .body p, .body ul, .body ol { margin: 0 0 0.95em; }
  .body li { margin: 0.28em 0; }
  .body li::marker { color: var(--muted); }
  .body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.6em auto;
    border-radius: 2px;
  }
  .body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86em;
    background: var(--code-bg);
    padding: 0.12em 0.34em;
    border-radius: 4px;
    hyphens: none;
  }
  .body pre {
    overflow: auto;
    padding: 1em 1.1em;
    background: var(--code-bg);
    margin: 0 0 1.2em;
    font-size: 0.9em;
    line-height: 1.45;
    border-radius: 6px;
  }
  .body pre code { background: none; padding: 0; }
  .body blockquote {
    margin: 0 0 1.15em;
    padding: 0.15em 0 0.15em 1.05em;
    border-left: 2px solid var(--rule);
    color: var(--quote);
  }
  .body blockquote p:last-child { margin-bottom: 0; }
  .body hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2.1em 0;
  }
  .alert {
    margin: 0 0 1.2em;
    padding: 1em 1.1em;
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    border-radius: 8px;
    font-style: normal;
    hyphens: none;
  }
  .alert-label {
    margin: 0 0 0.4em;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .alert p:last-child { margin-bottom: 0; }
</style>
</head><body>
<main>
  <nav class="crumbs" aria-label="Breadcrumb">
