# Emulator assets built by .github/workflows/container-runtime.yml and
# installed by fetch-runtime.sh. Tens of megabytes of generated wasm — the
# repo tracks the recipe, not the output.
out.js
out.worker.js
load.js
arg-module.js
SHA256SUMS
# The emulator and its packaged guest are named for the machine QEMU builds
# for, e.g. qemu-system-aarch64.wasm and qemu-system-aarch64.data.
*.wasm
*.wasm.gzip
*.data
