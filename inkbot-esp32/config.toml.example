# Copy to config.toml (gitignored) and fill in your values before flashing:
#   cp config.toml.example config.toml

[wifi]
ssid = "your-wifi-ssid"
pass = "your-wifi-password"

[inkbot]
# Worker base URL, no trailing slash.
# Example: "https://inkbot.<account>.workers.dev"
base_url = "https://inkbot.example.workers.dev"
# How often to poll GET / for catalog changes (new uploads show immediately).
poll_secs = 60
# How often to pick a random image from the rotation when nothing new arrived.
rotate_secs = 1800
# Bearer token; must match the Worker's UPLOAD_SECRET. Leave empty to disable
# remote POST /device (panel-only debug).
upload_secret = ""
# How often to POST /device when nothing about the error text changed.
# Boot and error transitions also POST immediately.
status_secs = 900
# How often to re-run DHCP while still associated (0 = only on fetch
# connect failures / dropped STA). lwIP also auto-renews; this is a
# safety net so a desk frame can stay up for months if auto-renew stalls.
dhcp_renew_secs = 21600
