CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384

# HTTPS to the inkbot Worker, GHCR, and (optional) Google APIs.
# Custom bundle is the PEMs in certs/ (GTS, ISRG, DigiCert, USERTrust,
# and GlobalSign Root CA) instead of the full Mozilla store. Cloudflare
# currently sends GTS Root R4 cross-signed by GlobalSign; ESP-IDF's
# bundle callback looks up that issuer and fails without it. IDF
# resolves the path relative to embuild's synthetic project, so the
# Makefile substitutes @PROJECT_DIR@.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="@PROJECT_DIR@/certs"
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# Classic ESP32 has ~160–200 KB DRAM after Wi-Fi. Default 16 KiB TLS
# records leave no contiguous room for the 48 KB panel framebuffer.
# 8 KiB is the minimum that fits Google OAuth / Cloud API chains
# (~4 KB DER plus TLS 1.3 framing); 4 KiB is enough for workers.dev.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# Trim Wi-Fi buffers so HTTPS + 48 KB frame can coexist.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@PROJECT_DIR@/partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Waveshare ESP32 driver board typically ships with 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
