#!/usr/bin/env bash
set -euo pipefail
${helpers}

install_docker
INTERNAL_IP="$(curl -fsS -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)"
install_ops_agent orchestrator "$INTERNAL_IP:8091"
retry 30 registry_login
mkdir -p /var/lib/sshcloud /usr/local/lib/sshcloud
# Remove files left by the retired static bearer-token deployment.
rm -f /var/lib/sshcloud/*_auth
install -d -o root -g root -m 0755 /run/sshcloud
install_control_identity_refresher \
  "${control_identity_secret}" \
  "${control_ca_current_secret}" \
  "${control_ca_previous_secret}" \
  /var/lib/sshcloud/control root root
echo "${drain_script_b64}" | base64 -d >/usr/local/sbin/sshcloud-drain-agent-host
chmod 0755 /usr/local/sbin/sshcloud-drain-agent-host

cat >/usr/local/lib/sshcloud/refresh-hosts.py <<'PY'
import json, os, urllib.request

PROJECT = os.environ["PROJECT_ID"]
ZONE = os.environ["ZONE"]
MIG = os.environ["MIG"]
OUT = os.environ.get("HOSTS_PATH", "/var/lib/sshcloud/hosts")
META = "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token"

def token():
    req = urllib.request.Request(META, headers={"Metadata-Flavor": "Google"})
    with urllib.request.urlopen(req) as r:
        return json.load(r)["access_token"]

def api(path, method="GET"):
    req = urllib.request.Request(
        "https://compute.googleapis.com/compute/v1/" + path,
        headers={"Authorization": "Bearer " + token()},
        method=method,
    )
    with urllib.request.urlopen(req) as r:
        return json.load(r)

mig = api(f"projects/{PROJECT}/zones/{ZONE}/instanceGroupManagers/{MIG}/listManagedInstances", method="POST")
lines = []
for inst in mig.get("managedInstances", []):
    url = inst.get("instance", "")
    name = url.rsplit("/", 1)[-1]
    if not name:
        continue
    desc = api(f"projects/{PROJECT}/zones/{ZONE}/instances/{name}")
    instance_id = str(desc.get("id", ""))
    if not instance_id.isdigit() or instance_id == "0":
        continue
    ip = desc["networkInterfaces"][0]["networkIP"]
    try:
        with urllib.request.urlopen(f"http://{ip}:8081/readyz", timeout=3) as ready:
            if ready.status != 200:
                continue
    except Exception as exc:
        print(f"skip unready host {name}: {exc}")
        continue
    lines.append(f"{name}@{instance_id}=https://{ip}:8080")
os.makedirs(os.path.dirname(OUT), exist_ok=True)
tmp = OUT + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + ("\n" if lines else ""))
os.replace(tmp, OUT)
print(f"wrote {len(lines)} hosts to {OUT}")
PY

cat >/etc/systemd/system/sshcloud-refresh-hosts.service <<EOF
[Unit]
Description=Refresh sshcloud agent host list from MIG
[Service]
Type=oneshot
Environment=PROJECT_ID=${project_id}
Environment=ZONE=${zone}
Environment=MIG=${mig_name}
Environment=HOSTS_PATH=${hosts_path}
ExecStart=/usr/bin/python3 /usr/local/lib/sshcloud/refresh-hosts.py
EOF

cat >/etc/systemd/system/sshcloud-refresh-hosts.timer <<'EOF'
[Unit]
Description=Refresh sshcloud agent host list every minute
[Timer]
OnBootSec=15s
OnUnitActiveSec=60s
[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now sshcloud-refresh-hosts.timer
/usr/bin/python3 /usr/local/lib/sshcloud/refresh-hosts.py || true

IMAGE="${orchestrator_image}"
retry 30 docker pull "$IMAGE"
docker rm -f sshcloud-orchestrator 2>/dev/null || true
docker run -d --name sshcloud-orchestrator --restart unless-stopped --net host \
  --log-driver=journald \
  --log-opt tag=sshcloud-platform-orchestrator \
  --user 0:0 \
  --cap-drop ALL \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=16m \
  -v /var/lib/sshcloud:/var/lib/sshcloud:ro \
  -v /run/sshcloud:/run/sshcloud:rw \
  "$IMAGE" \
  -listen "$${INTERNAL_IP}:8090" \
  -health-listen "$${INTERNAL_IP}:8091" \
  -admin-socket /run/sshcloud/orchestrator-admin.sock \
  -hosts-file ${hosts_path} \
  -control-cert /var/lib/sshcloud/control/tls.crt \
  -control-key /var/lib/sshcloud/control/tls.key \
  -control-ca-current /var/lib/sshcloud/control/ca-current.pem \
  -control-ca-previous /var/lib/sshcloud/control/ca-previous.pem \
  -control-project-id ${project_id} \
  -control-project-number ${project_number} \
  -gateway-service-account ${gateway_service_account} \
  -orchestrator-service-account ${orchestrator_service_account} \
  -gateway-url ${gateway_url} \
  -firestore-project ${project_id} \
  -firestore-prefix ${firestore_prefix} \
  -firestore-database ${firestore_database}
