# Standalone no-BLE 160 MHz ESP32-C3 (RISC-V) configuration for `xiao-esp32c3-gzip-bench`.
#
# Disabling Bluetooth and Wi-Fi maximizes ESP32-C3's unified 400 KiB SRAM so
# `miniz_oxide::deflate::core::CompressorOxide` (~308 KiB across HashBuffers +
# LZOxide + LocalBuf) can be tested directly on-chip.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@PROJECT_DIR@/partitions.csv"

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
