{
  "boards": {
    "xiao-esp32c3": {
      "board_id": 1,
      "chip": "esp32c3",
      "target": "riscv32imc-esp-espidf",
      "sdkconfig": "sdkconfig.defaults.xiao.in",
      "capabilities": ["logic-probe", "deep-sleep"]
    },
    "waveshare-epd75": {
      "board_id": 2,
      "chip": "esp32",
      "target": "xtensa-esp32-espidf",
      "sdkconfig": "sdkconfig.defaults.epd.in",
      "capabilities": ["epd75"]
    },
    "xiao-esp32s3-sense": {
      "board_id": 3,
      "chip": "esp32s3",
      "target": "xtensa-esp32s3-espidf",
      "sdkconfig": "sdkconfig.defaults.xiao-s3-sense.in",
      "extra_components": "extra_components.xiao-s3-sense.toml",
      "capabilities": ["camera", "mic", "sdcard", "wifi"]
    }
  },
  "apps": {
    "base": {
      "requires": [],
      "firmware_id_file": "src/protocol.rs",
      "firmware_id_const": "BASE_FIRMWARE_ID"
    },
    "bench": {
      "requires": ["logic-probe"],
      "firmware_id_file": "src/protocol.rs",
      "firmware_id_const": "FIRMWARE_ID"
    },
    "maze": {
      "requires": ["epd75"],
      "firmware_id_file": "src/maze/mod.rs",
      "firmware_id_const": "MAZE_FIRMWARE_ID"
    },
    "grayscale": {
      "requires": ["epd75"],
      "firmware_id_file": "src/grayscale/mod.rs",
      "firmware_id_const": "GRAYSCALE_FIRMWARE_ID"
    },
    "photo": {
      "requires": ["epd75"],
      "firmware_id_file": "src/photo.rs",
      "firmware_id_const": "PHOTO_FIRMWARE_ID"
    },
    "recorder": {
      "requires": ["camera", "mic", "sdcard", "wifi"],
      "firmware_id_file": "src/sense_clip.rs",
      "firmware_id_const": "RECORDER_FIRMWARE_ID"
    }
  }
}
