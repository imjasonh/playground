# Standalone no-BLE 240 MHz ESP32 configuration for `waveshare-epd75-gzip-bench`.
#
# Disabling Bluetooth and running unicore with a 4 KiB main stack moves
# `.dram0.heap_start` to ~0x3ffb39d8, freeing ~172 KiB of contiguous lower-bank
# DRAM so the silicon Mask-ROM `tdefl_compressor` (167,744 B) fits without PSRAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=3072

CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@PROJECT_DIR@/partitions.csv"

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
