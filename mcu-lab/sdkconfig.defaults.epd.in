CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Classic ESP32 (Xtensa LX6) NimBLE peripheral + broadcaster for BLE telemetry & OTA.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# No Wi-Fi or TLS needed — phone bridges telemetry and BLE OTA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_NAN_ENABLE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Dual-slot OTA partition table with automatic rollback on failed boot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@PROJECT_DIR@/partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Watchdogs and flash ELF coredumps for production crash diagnostics.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Waveshare e-Paper ESP32 driver board ships with 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
