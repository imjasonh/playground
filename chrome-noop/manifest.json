{
  "manifest_version": 3,
  "name": "Playground no-op",
  "version": "0.0.2",
  "description": "Opens a toolbar popup. It requests no permissions and collects no data.",
  "action": {
    "default_title": "Playground no-op",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
