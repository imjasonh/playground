import C3BootProofs.Spec.Base64
import C3BootProofs.Spec.Merkle

/-!
# The bundle container and the Rekor entry

The container CI builds from a Sigstore bundle, as `c3_verify::bundle`
reads it, and the Rekor v2 `hashedrekord` entry and its RFC 6962 leaf hash,
as `c3_verify::rekor` writes it (`c3-boot/docs/formats.md`).
-/

namespace C3

/-- The signed byte strings from a Sigstore bundle. -/
structure Bundle where
  leafCertificate : Bytes
  imageSignature : Bytes
  logIndex : Nat
  inclusionProof : Bytes
  checkpoint : Bytes
  timestamp : Bytes
  deriving DecidableEq, Repr

/-- `C3BN`. -/
def magicBundle : Bytes := [0x43, 0x33, 0x42, 0x4E]

/-- A length-prefixed field whose length is from `lo` to `hi`. -/
def readField (lo hi : Nat) (bytes : Bytes) : Option (Bytes × Bytes) := do
  let (len, rest) ← readU32 bytes
  require (lo ≤ len && len ≤ hi && len ≤ rest.length)
  pure (rest.take len, rest.drop len)

/-- A little-endian number. -/
def leNat : Bytes → Nat
  | [] => 0
  | b :: rest => b + 256 * leNat rest

/-- Decodes a bundle container, checking each field's length rule. -/
def decodeBundle (bytes : Bytes) : Option Bundle := do
  let rest ← readHeader magicBundle bytes
  let (leaf, rest) ← readField 1 4096 rest
  let (sig, rest) ← readField 8 72 rest
  let (index, rest) ← readField 8 8 rest
  let (proof, rest) ← readField 0 (maxProofHashes * 32) rest
  require (proof.length % 32 == 0)
  let (checkpoint, rest) ← readField 1 1024 rest
  let (timestamp, rest) ← readField 1 8192 rest
  require rest.isEmpty
  pure ⟨leaf, sig, leNat index, proof, checkpoint, timestamp⟩

/-- `{"apiVersion":"0.0.2","kind":"hashedrekord","spec":{"hashedRekordV002":{"data":{"algorithm":"SHA2_256","digest":"` -/
def rekorPre : Bytes :=
  [0x7B, 0x22, 0x61, 0x70, 0x69, 0x56, 0x65, 0x72, 0x73, 0x69, 0x6F, 0x6E, 0x22, 0x3A, 0x22, 0x30,
    0x2E, 0x30, 0x2E, 0x32, 0x22, 0x2C, 0x22, 0x6B, 0x69, 0x6E, 0x64, 0x22, 0x3A, 0x22, 0x68, 0x61,
    0x73, 0x68, 0x65, 0x64, 0x72, 0x65, 0x6B, 0x6F, 0x72, 0x64, 0x22, 0x2C, 0x22, 0x73, 0x70, 0x65,
    0x63, 0x22, 0x3A, 0x7B, 0x22, 0x68, 0x61, 0x73, 0x68, 0x65, 0x64, 0x52, 0x65, 0x6B, 0x6F, 0x72,
    0x64, 0x56, 0x30, 0x30, 0x32, 0x22, 0x3A, 0x7B, 0x22, 0x64, 0x61, 0x74, 0x61, 0x22, 0x3A, 0x7B,
    0x22, 0x61, 0x6C, 0x67, 0x6F, 0x72, 0x69, 0x74, 0x68, 0x6D, 0x22, 0x3A, 0x22, 0x53, 0x48, 0x41,
    0x32, 0x5F, 0x32, 0x35, 0x36, 0x22, 0x2C, 0x22, 0x64, 0x69, 0x67, 0x65, 0x73, 0x74, 0x22, 0x3A,
    0x22]

/-- `"},"signature":{"content":"` -/
def rekorMid1 : Bytes :=
  [0x22, 0x7D, 0x2C, 0x22, 0x73, 0x69, 0x67, 0x6E, 0x61, 0x74, 0x75, 0x72, 0x65, 0x22, 0x3A, 0x7B,
    0x22, 0x63, 0x6F, 0x6E, 0x74, 0x65, 0x6E, 0x74, 0x22, 0x3A, 0x22]

/-- `","verifier":{"keyDetails":"PKIX_ECDSA_P256_SHA_256","x509Certificate":{"rawBytes":"` -/
def rekorMid2 : Bytes :=
  [0x22, 0x2C, 0x22, 0x76, 0x65, 0x72, 0x69, 0x66, 0x69, 0x65, 0x72, 0x22, 0x3A, 0x7B, 0x22, 0x6B,
    0x65, 0x79, 0x44, 0x65, 0x74, 0x61, 0x69, 0x6C, 0x73, 0x22, 0x3A, 0x22, 0x50, 0x4B, 0x49, 0x58,
    0x5F, 0x45, 0x43, 0x44, 0x53, 0x41, 0x5F, 0x50, 0x32, 0x35, 0x36, 0x5F, 0x53, 0x48, 0x41, 0x5F,
    0x32, 0x35, 0x36, 0x22, 0x2C, 0x22, 0x78, 0x35, 0x30, 0x39, 0x43, 0x65, 0x72, 0x74, 0x69, 0x66,
    0x69, 0x63, 0x61, 0x74, 0x65, 0x22, 0x3A, 0x7B, 0x22, 0x72, 0x61, 0x77, 0x42, 0x79, 0x74, 0x65,
    0x73, 0x22, 0x3A, 0x22]

/-- `"}}}}}}` -/
def rekorPost : Bytes :=
  [0x22, 0x7D, 0x7D, 0x7D, 0x7D, 0x7D, 0x7D]

/-- The RFC 8785 canonical JSON of the Rekor v2 `hashedrekord` entry for an
image digest, its signature, and the leaf certificate. -/
def rekorEntry (digest signature certificate : Bytes) : Bytes :=
  rekorPre ++ base64Encode digest ++ rekorMid1 ++ base64Encode signature ++ rekorMid2 ++
    base64Encode certificate ++ rekorPost

/-- The entry's RFC 6962 leaf hash. -/
def rekorLeafHash (digest signature certificate : Bytes) : Bytes :=
  leafHash (rekorEntry digest signature certificate)

end C3
