import C3BootProofs.Models.Ed25519Fermat

/-!
# The affine Edwards law is a group law on the curve

`EdGroupLaws` holds when `p` is prime. The denominators `1 ± d x₁ x₂ y₁ y₂`
are nonzero on the curve (`den_ne`): if `d x₁ x₂ y₁ y₂ ≡ ε` with `ε = ±1`,
then `d` is the square of `(s x₁ + ε y₁) / (x₁ y₁ (s x₂ + y₂))` for
`s = ±sqrtM1`, which `d_nonsq_int` rules out. Each law is then a polynomial
identity modulo the curve equations, which `ring_mod` checks with cofactors
from `scripts/ring-cofactors.py`.
-/

namespace C3.RV32.EdM

open C3.Models

local notation "𝔭" => ((Ed25519.p : Nat) : Int)
local notation "𝔡" => ((Ed25519.d : Nat) : Int)

theorem ms {a b : Int} (h : MEq Ed25519.p a b) : (a - b) % 𝔭 = 0 := by
  have h' := MEq.iff_sub.mp h
  unfold MEq at h'; rw [Int.zero_emod] at h'; exact h'

theorem sm {a b : Int} (h : (a - b) % 𝔭 = 0) : MEq Ed25519.p a b := by
  apply MEq.iff_sub.mpr; unfold MEq; rw [Int.zero_emod]; exact h

theorem emod_sub (a : Int) : (a % 𝔭 - a) % 𝔭 = 0 := ms (MEq.emod a)

theorem p_sub : (𝔭 - 0) % 𝔭 = 0 := by rw [Int.sub_zero, Int.emod_self]

theorem one_ne : ¬ (1 : Int) % 𝔭 = 0 := by decide

theorem two_ne : ¬ MEq Ed25519.p 2 0 := by unfold MEq; decide

/-- The curve equation over `Int`. -/
def CurveI (x y : Int) : Prop := (-(x * x) + y * y - 1 - 𝔡 * (x * x) * (y * y)) % 𝔭 = 0

theorem curveI_of {q : Nat × Nat} (h : OnCurve q) : CurveI q.1 q.2 := by
  obtain ⟨_, _, h⟩ := h
  have h1 := ms (MEq.natCast.mpr h)
  simp only [Int.natCast_mul, Int.natCast_add, Int.natCast_emod, Int.natCast_one] at h1
  unfold CurveI
  ring_mod [h1 * 1, (emod_sub (𝔡 * ((q.1 : Int) * q.1))) * ((q.2 : Int) * q.2)]

theorem onCurve_of {q : Nat × Nat} (hx : q.1 < Ed25519.p) (hy : q.2 < Ed25519.p) (h : CurveI q.1 q.2) :
    OnCurve q := by
  refine ⟨hx, hy, MEq.natCast.mp (sm ?_)⟩
  simp only [Int.natCast_mul, Int.natCast_add, Int.natCast_emod, Int.natCast_one]
  unfold CurveI at h
  ring_mod [h * 1, (emod_sub (𝔡 * ((q.1 : Int) * q.1))) * (-((q.2 : Int) * q.2))]

/-- A nonzero `w` with `a² ≡ d w²` would make `d` a square. -/
theorem nonsq_ratio (hp : IsPrime Ed25519.p) (a w : Int) (hw : ¬ MEq Ed25519.p w 0)
    (h : MEq Ed25519.p (a * a) (𝔡 * (w * w))) : False := by
  have hp0 : (0 : Int) < 𝔭 := by decide
  have hwn : w % 𝔭 = (((w % 𝔭).toNat : Nat) : Int) :=
    (Int.toNat_of_nonneg (Int.emod_nonneg _ (Int.ne_of_gt hp0))).symm
  have hw' : MEq Ed25519.p w ((w % 𝔭).toNat : Nat) := by
    unfold MEq; rw [← hwn, Int.emod_emod_of_dvd _ (Int.dvd_refl _)]
  have h0 : (w % 𝔭).toNat % Ed25519.p ≠ 0 := by
    intro h0
    apply hw
    refine hw'.trans ?_
    rw [show (0 : Int) = ((0 : Nat) : Int) from rfl, MEq.natCast, h0, Nat.zero_mod]
  have hi := modInv_prime hp h0
  generalize ((w % 𝔭).toNat : Int) = w' at hw' hi
  generalize (modInv (w % 𝔭).toNat Ed25519.p : Int) = v at hi
  apply d_nonsq_int hp (a * v)
  apply sm
  have h2 := ms h
  have h3 := ms hw'
  have h4 := ms hi
  ring_mod [h2 * (v * v), h3 * (𝔡 * (w + w') * v * v), h4 * (𝔡 * (w' * v + 1))]

theorem ne_of_t (x1 x2 y1 y2 e : Int) (ht : (𝔡 * x1 * x2 * y1 * y2 - e) % 𝔭 = 0)
    (he : (e * e - 1) % 𝔭 = 0) : ¬ MEq Ed25519.p x1 0 ∧ ¬ MEq Ed25519.p y1 0 ∧ ¬ MEq Ed25519.p y2 0 := by
  refine ⟨fun h => one_ne ?_, fun h => one_ne ?_, fun h => one_ne ?_⟩
  · have h0 := ms h
    ring_mod [he * (-1), h0 * (e * 𝔡 * x2 * y1 * y2), ht * (-e)]
  · have h0 := ms h
    ring_mod [he * (-1), h0 * (e * 𝔡 * x1 * x2 * y2), ht * (-e)]
  · have h0 := ms h
    ring_mod [he * (-1), h0 * (e * 𝔡 * x1 * x2 * y1), ht * (-e)]

theorem bl_ident (x1 y1 x2 y2 e σ : Int) (h1 : CurveI x1 y1) (h2 : CurveI x2 y2)
    (ht : (𝔡 * x1 * x2 * y1 * y2 - e) % 𝔭 = 0) (he : (e * e - 1) % 𝔭 = 0) (hs : (σ * σ + 1) % 𝔭 = 0) :
    MEq Ed25519.p ((σ * x1 + e * y1) * (σ * x1 + e * y1)) (𝔡 * ((x1 * y1 * (σ * x2 + y2)) * (x1 * y1 * (σ * x2 + y2)))) := by
  unfold CurveI at h1 h2
  apply sm
  ring_mod [h1 * 1, he * (y1 * y1 - 1), ht * (-(𝔡 * x1 * x2 * y1 * y2 - e) - 2 * e - 2 * σ * x1 * y1),
    h2 * (-(𝔡 * (x1 * x1) * (y1 * y1))), hs * (x1 * x1 - 𝔡 * (x1 * x1) * (y1 * y1) * (x2 * x2))]

theorem sqrtM1_int : ((Ed25519.sqrtM1 : Int) * Ed25519.sqrtM1 + 1) % 𝔭 = 0 := by
  have h : (Ed25519.sqrtM1 * Ed25519.sqrtM1 + 1) % Ed25519.p = 0 % Ed25519.p := by
    rw [Nat.add_mod, sqrtM1_sq]; decide
  have h' := ms (MEq.natCast.mpr h)
  simp only [Int.natCast_mul, Int.natCast_add, Int.natCast_one, Int.natCast_zero, Int.sub_zero] at h'
  exact h'

/-- **Completeness**: `d x₁ x₂ y₁ y₂` is not `±1` on the curve. -/
theorem complete_int (hp : IsPrime Ed25519.p) (x1 y1 x2 y2 e : Int) (h1 : CurveI x1 y1) (h2 : CurveI x2 y2)
    (ht : (𝔡 * x1 * x2 * y1 * y2 - e) % 𝔭 = 0) (he : (e * e - 1) % 𝔭 = 0) : False := by
  obtain ⟨hx1, hy1, hy2⟩ := ne_of_t x1 x2 y1 y2 e ht he
  have hs := sqrtM1_int
  have hs' : (-(Ed25519.sqrtM1 : Int) * -(Ed25519.sqrtM1 : Int) + 1) % 𝔭 = 0 := by ring_mod [hs * 1]
  have hw : ∀ σ : Int, ¬ MEq Ed25519.p (σ * x2 + y2) 0 → ¬ MEq Ed25519.p (x1 * y1 * (σ * x2 + y2)) 0 :=
    fun σ hu => hp.meq_mul_ne (hp.meq_mul_ne hx1 hy1) hu
  by_cases hu : (Ed25519.sqrtM1 * x2 + y2) % 𝔭 = 0
  · by_cases hu' : (-(Ed25519.sqrtM1 : Int) * x2 + y2) % 𝔭 = 0
    · rcases hp.meq_mul_zero (a := 2) (b := y2) (sm (by ring_mod [hu * 1, hu' * 1])) with h | h
      · exact two_ne h
      · exact hy2 h
    · exact nonsq_ratio hp _ _ (hw _ (fun h => hu' (by have := ms h; rwa [Int.sub_zero] at this)))
        (bl_ident x1 y1 x2 y2 e _ h1 h2 ht he hs')
  · exact nonsq_ratio hp _ _ (hw _ (fun h => hu (by have := ms h; rwa [Int.sub_zero] at this)))
      (bl_ident x1 y1 x2 y2 e _ h1 h2 ht he hs)

theorem t_meq (x1 y1 x2 y2 : Nat) :
    MEq Ed25519.p ((Ed25519.d * x1 % Ed25519.p * x2 % Ed25519.p * y1 % Ed25519.p * y2 % Ed25519.p : Nat) : Int)
      (𝔡 * x1 * x2 * y1 * y2) := by
  rw [mod4]; refine (natMod _ _).trans ?_
  simp only [Int.natCast_mul]; exact MEq.refl _

/-- What `Ed25519.add` computes, as congruences with the denominators cleared,
and the denominators are nonzero. -/
theorem add_char (hp : IsPrime Ed25519.p) (P Q : Nat × Nat) (hP : OnCurve P) (hQ : OnCurve Q) :
    MEq Ed25519.p ((Ed25519.add P Q).1 * (1 + 𝔡 * P.1 * Q.1 * P.2 * Q.2)) (P.1 * Q.2 + P.2 * Q.1) ∧
    MEq Ed25519.p ((Ed25519.add P Q).2 * (1 - 𝔡 * P.1 * Q.1 * P.2 * Q.2)) (P.2 * Q.2 + P.1 * Q.1) ∧
    ¬ MEq Ed25519.p (1 + 𝔡 * P.1 * Q.1 * P.2 * Q.2) 0 ∧ ¬ MEq Ed25519.p (1 - 𝔡 * P.1 * Q.1 * P.2 * Q.2) 0 := by
  obtain ⟨x1, y1⟩ := P
  obtain ⟨x2, y2⟩ := Q
  have c1 := curveI_of hP
  have c2 := curveI_of hQ
  dsimp only at c1 c2 ⊢
  have ht := ms (t_meq x1 y1 x2 y2)
  have hn1 : ¬ MEq Ed25519.p (1 + 𝔡 * x1 * x2 * y1 * y2) 0 := fun h =>
    complete_int hp x1 y1 x2 y2 (-1) c1 c2 (by have := ms h; ring_mod [this * 1]) (by decide)
  have hn2 : ¬ MEq Ed25519.p (1 - 𝔡 * x1 * x2 * y1 * y2) 0 := fun h =>
    complete_int hp x1 y1 x2 y2 1 c1 c2 (by have := ms h; ring_mod [this * (-1)]) (by decide)
  refine ⟨?_, ?_, hn1, hn2⟩
  · simp only [Ed25519.add]
    generalize Ed25519.d * x1 % Ed25519.p * x2 % Ed25519.p * y1 % Ed25519.p * y2 % Ed25519.p = t at ht ⊢
    have hu : (1 + t) % Ed25519.p % Ed25519.p ≠ 0 := by
      intro h0; apply hn1
      have h1 : MEq Ed25519.p (((1 + t) % Ed25519.p : Nat) : Int) 0 := by
        rw [show (0 : Int) = ((0 : Nat) : Int) from rfl, MEq.natCast, h0, Nat.zero_mod]
      have h2 := ms h1
      simp only [Int.natCast_emod, Int.natCast_add, Int.natCast_one] at h2
      apply sm; ring_mod [h2 * 1, (emod_sub (1 + (t : Int))) * (-1), ht * (-1)]
    have hI := ms (modInv_prime hp hu)
    simp only [Int.natCast_emod, Int.natCast_add, Int.natCast_mul, Int.natCast_one] at hI ⊢
    unfold Ed25519.inv
    generalize ((modInv ((1 + t) % Ed25519.p) Ed25519.p : Nat) : Int) = iu at hI ⊢
    apply sm
    ring_mod [(emod_sub (((x1 : Int) * y2 + y1 * x2) % 𝔭 * iu)) * (1 + 𝔡 * x1 * x2 * y1 * y2),
      (emod_sub ((x1 : Int) * y2 + y1 * x2)) * (iu * (1 + 𝔡 * x1 * x2 * y1 * y2)),
      (emod_sub (1 + (t : Int))) * (-((x1 * y2 + y1 * x2) * iu)), ht * (-((x1 * y2 + y1 * x2) * iu)),
      hI * (x1 * y2 + y1 * x2)]
  · simp only [Ed25519.add]
    have htl : Ed25519.d * x1 % Ed25519.p * x2 % Ed25519.p * y1 % Ed25519.p * y2 % Ed25519.p < Ed25519.p :=
      Nat.mod_lt _ p_pos
    generalize Ed25519.d * x1 % Ed25519.p * x2 % Ed25519.p * y1 % Ed25519.p * y2 % Ed25519.p = t at ht htl ⊢
    have hv : ((1 + Ed25519.p - t : Nat) : Int) = 1 + 𝔭 - t := by
      rw [Int.natCast_sub (by omega), Int.natCast_add, Int.natCast_one]
    have hu : (1 + Ed25519.p - t) % Ed25519.p % Ed25519.p ≠ 0 := by
      intro h0; apply hn2
      have h1 : MEq Ed25519.p (((1 + Ed25519.p - t) % Ed25519.p : Nat) : Int) 0 := by
        rw [show (0 : Int) = ((0 : Nat) : Int) from rfl, MEq.natCast, h0, Nat.zero_mod]
      have h2 := ms h1
      simp only [Int.natCast_emod, hv] at h2
      apply sm; ring_mod [h2 * 1, (emod_sub (1 + 𝔭 - (t : Int))) * (-1), ht * 1, p_sub * (-1)]
    have hI := ms (modInv_prime hp hu)
    simp only [Int.natCast_emod, hv, Int.natCast_add, Int.natCast_mul] at hI ⊢
    unfold Ed25519.inv
    generalize ((modInv ((1 + Ed25519.p - t) % Ed25519.p) Ed25519.p : Nat) : Int) = iv at hI ⊢
    apply sm
    ring_mod [(emod_sub (((y1 : Int) * y2 + x1 * x2) % 𝔭 * iv)) * (1 - 𝔡 * x1 * x2 * y1 * y2),
      (emod_sub ((y1 : Int) * y2 + x1 * x2)) * (iv * (1 - 𝔡 * x1 * x2 * y1 * y2)),
      (emod_sub (1 + 𝔭 - (t : Int))) * (-((y1 * y2 + x1 * x2) * iv)), ht * ((y1 * y2 + x1 * x2) * iv),
      p_sub * (-((y1 * y2 + x1 * x2) * iv)), hI * (y1 * y2 + x1 * x2)]

