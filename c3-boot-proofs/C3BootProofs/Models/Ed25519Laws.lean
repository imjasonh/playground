    MEq Ed25519.p (((y₁ * y₂ + x₁ * x₂) * (1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * y₃ + (x₁ * y₂ + y₁ * x₂) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) * x₃) * ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) - 𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃) * (y₂ * y₃ + x₂ * x₃))) ((y₁ * (y₂ * y₃ + x₂ * x₃) * (1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) + x₁ * (x₂ * y₃ + y₂ * x₃) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃))) * ((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) - 𝔡 * (x₁ * y₂ + y₁ * x₂) * (y₁ * y₂ + x₁ * x₂) * x₃ * y₃)) := by
  unfold CurveI at h1 h2 h3
