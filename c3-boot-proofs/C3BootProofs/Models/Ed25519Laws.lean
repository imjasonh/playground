theorem assoc_y (hp : IsPrime Ed25519.p) (x₁ y₁ x₂ y₂ x₃ y₃ a b a' b' X X' : Int) (h1 : CurveI x₁ y₁) (h2 : CurveI x₂ y₂)
    (h3 : CurveI x₃ y₃) (ha : MEq Ed25519.p (a * (1 + (𝔡 * x₁ * x₂ * y₁ * y₂))) (x₁ * y₂ + y₁ * x₂)) (hb : MEq Ed25519.p (b * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂))) (y₁ * y₂ + x₁ * x₂))
    (ha' : MEq Ed25519.p (a' * (1 + (𝔡 * x₂ * x₃ * y₂ * y₃))) (x₂ * y₃ + y₂ * x₃)) (hb' : MEq Ed25519.p (b' * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃))) (y₂ * y₃ + x₂ * x₃))
    (hX : MEq Ed25519.p (X * (1 - 𝔡 * a * x₃ * b * y₃)) (b * y₃ + a * x₃))
    (hX' : MEq Ed25519.p (X' * (1 - 𝔡 * x₁ * a' * y₁ * b')) (y₁ * b' + x₁ * a'))
    (n1p : ¬ MEq Ed25519.p (1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) 0) (n1m : ¬ MEq Ed25519.p (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) 0) (n2p : ¬ MEq Ed25519.p (1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) 0)
    (n2m : ¬ MEq Ed25519.p (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) 0) (nL : ¬ MEq Ed25519.p (1 - 𝔡 * a * x₃ * b * y₃) 0)
    (nR : ¬ MEq Ed25519.p (1 - 𝔡 * x₁ * a' * y₁ * b') 0) : MEq Ed25519.p X X' := by
  have eL : MEq Ed25519.p (X * ((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) - 𝔡 * (x₁ * y₂ + y₁ * x₂) * (y₁ * y₂ + x₁ * x₂) * x₃ * y₃)) ((y₁ * y₂ + x₁ * x₂) * (1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * y₃ + (x₁ * y₂ + y₁ * x₂) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) * x₃) := sm (by ring_mod [(ms hX) * ((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂))), (ms ha) * (X * 𝔡 * x₃ * y₃ * b * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) + (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) * x₃), (ms hb) * (X * 𝔡 * x₃ * y₃ * (x₁ * y₂ + y₁ * x₂) + (1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * y₃)])
  have eR : MEq Ed25519.p (X' * ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) - 𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃) * (y₂ * y₃ + x₂ * x₃))) (y₁ * (y₂ * y₃ + x₂ * x₃) * (1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) + x₁ * (x₂ * y₃ + y₂ * x₃) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃))) := sm (by ring_mod [(ms hX') * ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃))), (ms ha') * (X' * 𝔡 * x₁ * y₁ * b' * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) + x₁ * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃))), (ms hb') * (X' * 𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃) + y₁ * (1 + (𝔡 * x₂ * x₃ * y₂ * y₃)))])
  have kL : ¬ MEq Ed25519.p ((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) - 𝔡 * (x₁ * y₂ + y₁ * x₂) * (y₁ * y₂ + x₁ * x₂) * x₃ * y₃) 0 := fun h =>
    hp.meq_mul_ne (hp.meq_mul_ne n1p n1m) nL (sm (a := ((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - 𝔡 * a * x₃ * b * y₃))) (b := 0) (by ring_mod [(ms h) * 1, (ms ha) * (-(𝔡 * x₃ * y₃ * b * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)))), (ms hb) * (-(𝔡 * x₃ * y₃ * (x₁ * y₂ + y₁ * x₂)))]))
  have kR : ¬ MEq Ed25519.p ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) - 𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃) * (y₂ * y₃ + x₂ * x₃)) 0 := fun h =>
    hp.meq_mul_ne (hp.meq_mul_ne n2p n2m) nR (sm (a := ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - 𝔡 * x₁ * a' * y₁ * b'))) (b := 0) (by ring_mod [(ms h) * 1, (ms ha') * (-(𝔡 * x₁ * y₁ * b' * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)))), (ms hb') * (-(𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃)))]))
  have big := ms (assoc_y_ident x₁ y₁ x₂ y₂ x₃ y₃ h1 h2 h3)
  refine hp.meq_cancel (hp.meq_mul_ne kL kR) (sm ?_)
  ring_mod [(ms eL) * ((1 + (𝔡 * x₂ * x₃ * y₂ * y₃)) * (1 - (𝔡 * x₂ * x₃ * y₂ * y₃)) - 𝔡 * x₁ * y₁ * (x₂ * y₃ + y₂ * x₃) * (y₂ * y₃ + x₂ * x₃)), big * 1, (ms eR) * (-((1 + (𝔡 * x₁ * x₂ * y₁ * y₂)) * (1 - (𝔡 * x₁ * x₂ * y₁ * y₂)) - 𝔡 * (x₁ * y₂ + y₁ * x₂) * (y₁ * y₂ + x₁ * x₂) * x₃ * y₃))]

theorem add_lt (P Q : Nat × Nat) : (Ed25519.add P Q).1 < Ed25519.p ∧ (Ed25519.add P Q).2 < Ed25519.p := by
  obtain ⟨_, _⟩ := P
  obtain ⟨_, _⟩ := Q
  exact ⟨Nat.mod_lt _ p_pos, Nat.mod_lt _ p_pos⟩

theorem meq_eq {u v : Nat} (h : MEq Ed25519.p u v) (hu : u < Ed25519.p) (hv : v < Ed25519.p) : u = v := by
  have h' := MEq.natCast.mp h
  rwa [Nat.mod_eq_of_lt hu, Nat.mod_eq_of_lt hv] at h'

theorem closed_ident (x₁ y₁ x₂ y₂ X Y : Int) (h1 : CurveI x₁ y₁) (h2 : CurveI x₂ y₂)
    (hx : MEq Ed25519.p (X * (1 + 𝔡 * x₁ * x₂ * y₁ * y₂)) (x₁ * y₂ + y₁ * x₂))
    (hy : MEq Ed25519.p (Y * (1 - 𝔡 * x₁ * x₂ * y₁ * y₂)) (y₁ * y₂ + x₁ * x₂)) :
    MEq Ed25519.p ((-(X * X) + Y * Y - 1 - 𝔡 * (X * X) * (Y * Y)) *
      ((1 + 𝔡 * x₁ * x₂ * y₁ * y₂) * (1 + 𝔡 * x₁ * x₂ * y₁ * y₂) *
        ((1 - 𝔡 * x₁ * x₂ * y₁ * y₂) * (1 - 𝔡 * x₁ * x₂ * y₁ * y₂)))) 0 := by
  unfold CurveI at h1 h2
  have hx' := ms hx
  have hy' := ms hy
