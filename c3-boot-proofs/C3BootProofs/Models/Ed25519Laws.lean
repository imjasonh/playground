/-- The sum of two points of the curve is on the curve. -/
theorem add_closed (hp : IsPrime Ed25519.p) (P Q : Nat × Nat) (hP : OnCurve P) (hQ : OnCurve Q) :
    OnCurve (Ed25519.add P Q) := by
  obtain ⟨hx, hy, n1, n2⟩ := add_char hp P Q hP hQ
  have hl := add_lt P Q
  refine onCurve_of hl.1 hl.2 ?_
  rcases hp.meq_mul_zero (closed_ident _ _ _ _ _ _ (curveI_of hP) (curveI_of hQ) hx hy) with h | h
  · have h' := ms h; rwa [Int.sub_zero] at h'
  · exact absurd h (hp.meq_mul_ne (hp.meq_mul_ne n1 n1) (hp.meq_mul_ne n2 n2))

/-- `P + (-P) = (0, 1)`. -/
theorem add_neg_self (hp : IsPrime Ed25519.p) (P : Nat × Nat) (hP : OnCurve P) :
    Ed25519.add P (neg P) = Ed25519.zero := by
  obtain ⟨hx, hy, n1, n2⟩ := add_char hp P (neg P) hP (onCurve_neg P hP)
  have hl := add_lt P (neg P)
  have c := curveI_of hP
  obtain ⟨x, y⟩ := P
  have hneg : ((((Ed25519.p - x) % Ed25519.p : Nat) : Int) + x) % 𝔭 = 0 := by
    rw [Int.natCast_emod, Int.natCast_sub (Nat.le_of_lt hP.1)]
    ring_mod [(emod_sub (𝔭 - (x : Int))) * 1, p_sub * 1]
  unfold neg at hx hy n1 n2 hl ⊢
  unfold CurveI at c
  dsimp only at hx hy n1 n2 hl c ⊢
  generalize Ed25519.add (x, y) ((Ed25519.p - x) % Ed25519.p, y) = S at hx hy hl ⊢
  generalize (((Ed25519.p - x) % Ed25519.p : Nat) : Int) = x' at hx hy n1 n2 hneg
  have h0 : MEq Ed25519.p ((S.1 : Int) * (1 + 𝔡 * x * x' * y * y)) 0 :=
    sm (by ring_mod [(ms hx) * 1, hneg * (y : Int)])
  have h1 : MEq Ed25519.p (((S.2 : Int) - 1) * (1 - 𝔡 * x * x' * y * y)) 0 :=
    sm (by ring_mod [(ms hy) * 1, c * 1, hneg * ((x : Int) + 𝔡 * x * y * y)])
  rcases hp.meq_mul_zero h0 with h0 | h0
  · rcases hp.meq_mul_zero h1 with h1 | h1
    · exact Prod.ext (meq_eq h0 hl.1 p_pos) (meq_eq (MEq.iff_sub.mpr h1) hl.2 one_lt_p)
    · exact absurd h1 n2
  · exact absurd h0 n1

/-- `(P + Q) + R = P + (Q + R)`. -/
theorem add_assoc' (hp : IsPrime Ed25519.p) (P Q R : Nat × Nat) (hP : OnCurve P) (hQ : OnCurve Q)
    (hR : OnCurve R) : Ed25519.add (Ed25519.add P Q) R = Ed25519.add P (Ed25519.add Q R) := by
  have hA := add_closed hp P Q hP hQ
  have hB := add_closed hp Q R hQ hR
  obtain ⟨ha, hb, n1p, n1m⟩ := add_char hp P Q hP hQ
  obtain ⟨ha', hb', n2p, n2m⟩ := add_char hp Q R hQ hR
  obtain ⟨hX, hY, nLx, nLy⟩ := add_char hp _ R hA hR
  obtain ⟨hX', hY', nRx, nRy⟩ := add_char hp P _ hP hB
  have l1 := add_lt (Ed25519.add P Q) R
  have l2 := add_lt P (Ed25519.add Q R)
  exact Prod.ext
    (meq_eq (assoc_x hp _ _ _ _ _ _ _ _ _ _ _ _ (curveI_of hP) (curveI_of hQ) (curveI_of hR) ha hb ha' hb' hX hX'
      n1p n1m n2p n2m nLx nRx) l1.1 l2.1)
    (meq_eq (assoc_y hp _ _ _ _ _ _ _ _ _ _ _ _ (curveI_of hP) (curveI_of hQ) (curveI_of hR) ha hb ha' hb' hY hY'
      n1p n1m n2p n2m nLy nRy) l1.2 l2.2)

/-- **`EdGroupLaws` holds when `p` is prime.** -/
theorem edGroupLaws (hp : IsPrime Ed25519.p) : EdGroupLaws :=
  ⟨add_closed hp, add_assoc' hp, add_neg_self hp⟩

