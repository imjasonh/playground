theorem svTsa4n23aa_end : blockEnd sigstoreVerifyCode 0x23AA svTsa4n23aa = some 0x23B4 := by
  simp only [svTsa4n23aa]
  rw [blockEnd, sv_at_23aa]; dsimp only; rw [if_pos (by decide)]; simp only [BitVec.reduceToNat, Nat.reduceAdd]
  rw [blockEnd, sv_at_23ae]; dsimp only; rw [if_pos (by decide)]; simp only [BitVec.reduceToNat, Nat.reduceAdd]
  rw [blockEnd, sv_at_23b0]; dsimp only; rw [if_pos (by decide)]; simp only [BitVec.reduceToNat, Nat.reduceAdd]
  rfl

