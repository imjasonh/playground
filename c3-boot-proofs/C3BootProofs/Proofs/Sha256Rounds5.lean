      reg n' (28 : Fin 32) = w 49 ∧
      reg n' (29 : Fin 32) = w 51 ∧
      reg n' (30 : Fin 32) = w 39 ∧
      reg n' (31 : Fin 32) = (vsW w hv 50).a ∧
      memLoad32 M' (F + BitVec.ofNat 32 0x28) = hv.a ∧
