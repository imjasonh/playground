    (m58 : memLoad32 M (F + BitVec.ofNat 32 0x58) = w 43)
    (m5c : memLoad32 M (F + BitVec.ofNat 32 0x5C) = w 41)
    (m60 : memLoad32 M (F + BitVec.ofNat 32 0x60) = hv.c)
    (m68 : memLoad32 M (F + BitVec.ofNat 32 0x68) = hv.b) :
    ∃ n' M', Steps n n' ∧
      St M' (P + BitVec.ofNat 32 0x21E8) n' 0x134 (reg n') ∧
      (∀ x, Sep (F + BitVec.ofNat 32 0x14) 0x58 x 1 → M' x = M0 x) ∧
      reg n' ra = w 40 ∧
