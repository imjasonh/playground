      n'.mem (B + 0x420 + BitVec.ofNat 32 0xD80) = 0 ∧
      n'.mem (B + 0x420 + BitVec.ofNat 32 0x1744) = 0 ∧
      n'.mem (B + 0x420 + BitVec.ofNat 32 0x17D4) = 0 ∧
      memLoad32 n'.mem (B + 0x420 + BitVec.ofNat 32 0x10) = (if PZ = 0 then 0 else 1) ∧
      memLoad32 n'.mem (B + 0x420 + BitVec.ofNat 32 0x40) = BitVec.ofNat 32 0x1 ∧
      memLoad32 n'.mem (B + 0x420 + BitVec.ofNat 32 0xE70) = BitVec.ofNat 32 0xFFFFFFFF ∧
      memLoad32 n'.mem (B + 0x420 + BitVec.ofNat 32 0xE74) = BitVec.ofNat 32 0xFFFFFFFE := by
  have t0 : Steps n0 n0 := .refl n0
  have fR0 : ∀ x, PvR B x → n0.mem x = n0.mem x := fun _ _ => rfl
  have g0_3 : reg n0 (3 : Fin 32) = reg n0 (3 : Fin 32) := rfl
