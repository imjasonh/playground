    (E0 : PvEnv3 n0.mem)
    (s0 : St n0.mem PV n0 0xCE8 (reg n0))
    (g0_2 : reg n0 sp = B + 0x420)
    (g0_3 : reg n0 (3 : Fin 32) = reg n0 (3 : Fin 32))
    (g0_4 : reg n0 (4 : Fin 32) = reg n0 (4 : Fin 32))
    (g0_10 : reg n0 a0 = BitVec.ofNat 32 rem)
    (g0_19 : reg n0 (19 : Fin 32) = B + 0x420 + BitVec.ofNat 32 0xD80)
    (g0_24 : reg n0 (24 : Fin 32) = dh)
