    (l0_270 : (n0.mem (B + 0x420 + BitVec.ofNat 32 (0x270 + 0x30))).toNat ≤ 1)
    (v0_d50 : sgnVal (n0.mem (B + 0x420 + BitVec.ofNat 32 (0xD50 + 0x30))).toNat (accV n0.mem (B + 0x420 + BitVec.ofNat 32 0xD50) 12) = Gv)
    (l0_d50 : (n0.mem (B + 0x420 + BitVec.ofNat 32 (0xD50 + 0x30))).toNat ≤ 1)
    (v0_1714 : sgnVal (n0.mem (B + 0x420 + BitVec.ofNat 32 (0x1714 + 0x30))).toNat (accV n0.mem (B + 0x420 + BitVec.ofNat 32 0x1714) 12) = Fv)
    (l0_1714 : (n0.mem (B + 0x420 + BitVec.ofNat 32 (0x1714 + 0x30))).toNat ≤ 1)
    (v0_17a4 : sgnVal (n0.mem (B + 0x420 + BitVec.ofNat 32 (0x17A4 + 0x30))).toNat (accV n0.mem (B + 0x420 + BitVec.ofNat 32 0x17A4) 12) = Ev)
    (l0_17a4 : (n0.mem (B + 0x420 + BitVec.ofNat 32 (0x17A4 + 0x30))).toNat ≤ 1) (hrem : rem < 2 ^ 32) (h0 : rem ≠ 0) :
    ∃ n', Steps n0 n' ∧
      St n'.mem PV n' 0xD36 (reg n') ∧
      PvEnv3 n'.mem ∧
      (∀ x, PvR B x → n'.mem x = n0.mem x) ∧
