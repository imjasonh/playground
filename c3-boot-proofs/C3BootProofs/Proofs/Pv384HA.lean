    (a0_1c88 : accV n0.mem (B + 0x420 + BitVec.ofNat 32 0x1C88) 12 = PX)
    (a0_1cb8 : accV n0.mem (B + 0x420 + BitVec.ofNat 32 0x1CB8) 12 = PY)
