      reg n' (3 : Fin 32) = reg n0 (3 : Fin 32) ∧
      reg n' (4 : Fin 32) = reg n0 (4 : Fin 32) ∧
      reg n' (8 : Fin 32) = B + 0x420 + BitVec.ofNat 32 0xD80 ∧
      reg n' a3 = BitVec.ofNat 32 0x0 ∧
      reg n' a4 = BitVec.ofNat 32 (min rem 62) ∧
      reg n' (18 : Fin 32) = BitVec.ofNat 32 0x0 ∧
      reg n' (19 : Fin 32) = B + 0x420 + BitVec.ofNat 32 0xD80 ∧
