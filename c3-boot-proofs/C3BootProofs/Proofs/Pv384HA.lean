import C3BootProofs.Proofs.Pv384HS

/-!
# `p384_verify_prehash`: the start of a batch of the inversion of `Z`

Generated by `scripts/gen-p384-verify.py HA`. From 0xCE8 to 0xD36: the batch's length, the low words of `f` and `g`, and the identity
matrix, in the frame slots and registers the constant-time divsteps use.
-/

namespace C3.RV32.Pv

open C3.Image C3.RV32.P3 C3.RV32.Dq

set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false

def pvHAcf2 : List BInstr :=
  [.alu .add (8 : Fin 32) x0 a0, .lui a0 0x1000, .aluImm .add a0 a0 0x714, .alu .add a0 a0 sp]
theorem pvHAcf2_end : blockEnd p384VerifyPrehashCode 0xCF2 pvHAcf2 = some 0xCFC := by decide

def pvHAd08 : List BInstr :=
  [.aluImm .add a0 sp 0x7FF, .aluImm .add a0 a0 0x551]
theorem pvHAd08_end : blockEnd p384VerifyPrehashCode 0xD08 pvHAd08 = some 0xD10 := by decide

def pvHAd1c : List BInstr :=
  [.aluImm .add a3 x0 0x0]
theorem pvHAd1c_end : blockEnd p384VerifyPrehashCode 0xD1C pvHAd1c = some 0xD1E := by decide

def pvHAd20 : List BInstr :=
  [.aluImm .add (18 : Fin 32) x0 0x0, .aluImm .add (20 : Fin 32) x0 0x0, .aluImm .add (25 : Fin 32) x0 0x0, .aluImm .add (26 : Fin 32) x0 0x0, .aluImm .add (22 : Fin 32) x0 0x1, .aluImm .add (23 : Fin 32) x0 0x1]
theorem pvHAd20_end : blockEnd p384VerifyPrehashCode 0xD20 pvHAd20 = some 0xD2C := by decide

def pvHAd2e : List BInstr :=
  [.alu .add a4 x0 (8 : Fin 32), .alu .add (8 : Fin 32) x0 (19 : Fin 32)]
theorem pvHAd2e_end : blockEnd p384VerifyPrehashCode 0xD2E pvHAd2e = some 0xD32 := by decide

set_option maxHeartbeats 0 in
/-- **The start of a batch of stage H**, from 0xCE8 to 0xD36. -/
theorem pv_stHA {B : Word} {zf dl dh : Word} {rem RM PX PY : Nat} {Fv Gv Dv Ev : Int} {n0 : Machine}
