    (r8 : reg n (8 : Fin 32) = (vsW w hv 3).e)
    (r9 : reg n (9 : Fin 32) = (vsW w hv 5).e)
    (r10 : reg n a0 = ktAt 5)
    (r12 : reg n a2 = (vsW w hv 5).a)
    (r16 : reg n a6 = (vsW w hv 3).a)
    (r18 : reg n (18 : Fin 32) = w 6)
    (r19 : reg n (19 : Fin 32) = w 4)
    (r20 : reg n (20 : Fin 32) = w 2)
    (r21 : reg n (21 : Fin 32) = (vsW w hv 4).a)
    (r23 : reg n (23 : Fin 32) = w 13)
    (r24 : reg n (24 : Fin 32) = w 3)
    (r25 : reg n (25 : Fin 32) = (vsW w hv 2).e)
    (r26 : reg n (26 : Fin 32) = (vsW w hv 2).a)
    (r27 : reg n (27 : Fin 32) = (vsW w hv 4).e)
    (r29 : reg n (29 : Fin 32) = w 14)
    (r30 : reg n (30 : Fin 32) = w 11)
    (r31 : reg n (31 : Fin 32) = w 5)
    (m24 : memLoad32 M (F + BitVec.ofNat 32 0x24) = w 0)
    (m28 : memLoad32 M (F + BitVec.ofNat 32 0x28) = hv.a)
    (m2c : memLoad32 M (F + BitVec.ofNat 32 0x2C) = hv.e)
    (m30 : memLoad32 M (F + BitVec.ofNat 32 0x30) = hv.g)
    (m34 : memLoad32 M (F + BitVec.ofNat 32 0x34) = hv.h)
    (m38 : memLoad32 M (F + BitVec.ofNat 32 0x38) = hv.f)
