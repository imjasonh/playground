    (r2 : reg n sp = F)
    (r4 : reg n (4 : Fin 32) = tp0)
    (r5 : reg n (5 : Fin 32) = w 7)
    (r6 : reg n (6 : Fin 32) = BitVec.ofNat 32 shaKAddress)
