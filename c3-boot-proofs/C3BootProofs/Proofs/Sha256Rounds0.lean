    (m64 : memLoad32 M (F + BitVec.ofNat 32 0x64) = w 15)
    (m68 : memLoad32 M (F + BitVec.ofNat 32 0x68) = hv.b) :
    ∃ n' M', Steps n n' ∧
      St M' (P + BitVec.ofNat 32 0x7EE) n' 0x132 (reg n') ∧
      (∀ x, Sep (F + BitVec.ofNat 32 0x14) 0x58 x 1 → M' x = M0 x) ∧
      reg n' ra = w 1 ∧
      reg n' sp = F ∧
      reg n' (4 : Fin 32) = tp0 ∧
      reg n' (6 : Fin 32) = w 16 ∧
      reg n' (7 : Fin 32) = w 12 ∧
      reg n' (8 : Fin 32) = (vsW w hv 14).a ∧
      reg n' a2 = (vsW w hv 16).e ∧
      reg n' a3 = (vsW w hv 15).e ∧
      reg n' a6 = (vsW w hv 15).a ∧
      reg n' (17 : Fin 32) = (vsW w hv 14).e ∧
      reg n' (18 : Fin 32) = w 6 ∧
      reg n' (19 : Fin 32) = w 4 ∧
      reg n' (20 : Fin 32) = w 2 ∧
      reg n' (21 : Fin 32) = (vsW w hv 16).a ∧
