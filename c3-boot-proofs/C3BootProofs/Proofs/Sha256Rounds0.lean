  have g14_5 : reg n5 a4 = ((vsW w hv 15).e) >>> 11 := (reg_step_ne u5 rfl (reg_step_ne u4 rfl (reg_step_eq u3 rfl)))
  obtain ⟨n6, d6, u6⟩ := sha_or_lr (off' := 0x14) (r := 11) (l := 21) u5.self (cwOf fr) s7_at_12 rfl rfl g14_5 g9_5
