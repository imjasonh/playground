  have g11_4 : reg n4 a1 = ((vsW w hv 15).e) >>> 6 := (reg_step_ne u4 rfl (reg_step_ne u3 rfl (reg_step_ne u2 rfl (reg_step_eq u1 rfl))))
  have g15_4 : reg n4 a5 = ((vsW w hv 15).e) <<< 26 := (reg_step_ne u4 rfl (reg_step_ne u3 rfl (reg_step_eq u2 rfl)))
  obtain ⟨n5, d5, u5⟩ := sha_or_lr (off' := 0x12) (r := 6) (l := 26) u4.self (cwOf fr) s7_at_10 rfl rfl g11_4 g15_4
