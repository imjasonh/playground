    (m64 : memLoad32 M (F + BitVec.ofNat 32 0x64) = w 15)
    (m68 : memLoad32 M (F + BitVec.ofNat 32 0x68) = hv.b) :
    ∃ n' M', Steps n n' ∧
      St M' (P + BitVec.ofNat 32 0x528) n' 0xF2 (reg n') ∧
      (∀ x, Sep (F + BitVec.ofNat 32 0x14) 0x58 x 1 → M' x = M0 x) ∧
