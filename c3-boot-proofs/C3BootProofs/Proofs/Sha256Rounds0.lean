    (r7 : reg n (7 : Fin 32) = w 12)
    (r8 : reg n (8 : Fin 32) = (vsW w hv 14).a)
    (r10 : reg n a0 = ktAt 15)
    (r12 : reg n a2 = (vsW w hv 12).a)
    (r13 : reg n a3 = (vsW w hv 15).e)
    (r16 : reg n a6 = (vsW w hv 15).a)
    (r17 : reg n (17 : Fin 32) = (vsW w hv 14).e)
    (r18 : reg n (18 : Fin 32) = w 6)
    (r19 : reg n (19 : Fin 32) = w 4)
    (r20 : reg n (20 : Fin 32) = w 2)
    (r21 : reg n (21 : Fin 32) = (vsW w hv 12).e)
    (r23 : reg n (23 : Fin 32) = BitVec.ofNat 32 shaKAddress)
    (r24 : reg n (24 : Fin 32) = w 3)
    (r26 : reg n (26 : Fin 32) = (vsW w hv 13).a)
