    (m54 : memLoad32 M (F + BitVec.ofNat 32 0x54) = w 13)
    (m58 : memLoad32 M (F + BitVec.ofNat 32 0x58) = w 10)
    (m5c : memLoad32 M (F + BitVec.ofNat 32 0x5C) = w 9)
    (m60 : memLoad32 M (F + BitVec.ofNat 32 0x60) = hv.c)
    (m64 : memLoad32 M (F + BitVec.ofNat 32 0x64) = w 15)
    (m68 : memLoad32 M (F + BitVec.ofNat 32 0x68) = hv.b) :
    ∃ n' M', Steps n n' ∧
      St M' (P + BitVec.ofNat 32 0x356) n' 0xE6 (reg n') ∧
      (∀ x, Sep (F + BitVec.ofNat 32 0x14) 0x58 x 1 → M' x = M0 x) ∧
      reg n' ra = w 1 ∧
      reg n' sp = F ∧
      reg n' (4 : Fin 32) = tp0 ∧
      reg n' (5 : Fin 32) = w 7 ∧
