// Platformer — a side-scrolling demo that exercises most of the
// NEScript compiler in one program: custom CHR tiles, a 32×30
// background with per-region attribute palettes, a 2×2 hero with
// walk / jump frames and horizontal flipping, jump physics with
// variable height and one-way brick platforms, a level that loops
// every 256 pixels, walkers you can stomp, spinning coins, a HUD
// pinned to the top of the screen by a sprite-0 hit scroll split,
// lives that carry across deaths, SFX and music, and a
// Title → Playing → GameOver state machine.
//
// Left alone, the title screen hands over to an attract-mode demo
// so the headless jsnes harness, which presses no buttons, still
// sees the loop: two stomps, a death, a retry.
//
// Controls:
//     Start             — start a game (from the title or the demo)
//     D-pad left/right  — walk; hold B to run
//     A                 — jump; release early for a short hop, and
//                         hold it through a stomp to bounce high
//
// Build:  cargo run --release -- build examples/platformer.ne
// Output: examples/platformer.nes
//
// The CHR tile art, the TILE_* constants, and the `background Level`
// legend, map, and palette map are generated by
// `cargo run --bin gen_platformer_tiles`. Change
// `scripts/gen_platformer_tiles.rs` and paste its output here.

game "Platformer" {
    mapper: NROM
    // Horizontal arrangement means nametable 1 mirrors nametable 0
    // horizontally, so the one loaded nametable repeats as the
    // camera scrolls right.
    mirroring: horizontal
}

// ── Palette ──────────────────────────────────────────────────
// One shared `universal:` colour fills every sub-palette's index-0
// slot, which avoids the `$3F10/$3F14/$3F18/$3F1C` mirror trap.
// 0x22 is the periwinkle sky blue.
palette Main {
    universal: 0x22

    bg0: [white,        sky_blue,     black]        // sky, clouds, text, HUD
    bg1: [orange,       black,        dk_orange]    // bricks, ? blocks
    bg2: [neon_green,   bright_green, dk_green]     // hills, bushes
    bg3: [neon_green,   brown,        dk_orange]    // grass, dirt

    sp0: [red,          tan,          brown]        // hero
    sp1: [dk_orange,    tan,          black]        // walkers
    sp2: [yellow,       dk_orange,    cream]        // coins
    sp3: [white,        red,          black]        // GAME OVER text, heart
}

// Sprite attribute bytes: bits 0-1 pick the sprite palette, bit 6
// flips the tile horizontally, bit 7 flips it vertically.
const ATTR_WALKER: u8 = 0x01
const ATTR_COIN:   u8 = 0x02
const ATTR_TEXT:   u8 = 0x03
const FLIP_H:      u8 = 0x40
const FLIP_V:      u8 = 0x80

// ── Tileset ──────────────────────────────────────────────────
