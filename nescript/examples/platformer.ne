// ── Background ──────────────────────────────────────────────
// Row 1 is the HUD: two score digits and the lives digit. The coin
// and heart icons beside them are sprites. Row 0 stays sky because
// jsnes and many TVs hide the top 8 scanlines. The `!` at the end of
// row 1 is the background half of the sprite-0 hit pair.
//
// The brick rows on row 15 are one-way platforms (`PLAT_X`,
// `PLAT_W`, `PLAT_TOP` below must match). Rows 8 and 11 stay empty
// for the title text.
background Level {
    legend {
        ".": 22   // sky
        "(": 23   // cloud, top row
        "-": 24
        ")": 25
        "[": 26   // cloud, bottom row
        "_": 27
        "]": 28
        "#": 29   // brick (one-way platform)
        "Q": 30   // ? block (one-way platform)
        "{": 31   // hill cap
        "}": 32
        "/": 33   // hill slopes
        "\\": 36
        "^": 34   // hill fill
        "o": 35   // hill fill with spots
        "<": 37   // bush
        "*": 38
        ">": 39
        "=": 40   // grass top
        "%": 41   // dirt
        "@": 42   // rock in the dirt
        "0": 1   // HUD: score tens and ones
        "3": 4   // HUD: lives
        "~": 65   // HUD rule; the sprite-0 hit anchor
    }

    map: [
        "................................",
        "....00....................3.....",
        "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",
        "..(-)..................(-)......",
        "..[_]........(-).......[_]......",
        ".............[_]................",
        "................................",
        "................................",
        "................................",
        "................................",
        "................................",
        "................................",
        "................................",
        "................................",
        "................................",
        "......##Q##........#Q#..........",
        "................................",
        "................................",
        "................................",
        "...{}...........................",
        "../^^\\..............{}..........",
        "./^o^^\\..<**>....../^o\\...<*>...",
        "================================",
        "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
        "%%%%%@%%%%%%%%%%%%%@%%%%%%%%%%%%",
        "%%%%%%%%%%%%%@%%%%%%%%%%%%%%@%%%",
        "%%%@%%%%%%%%%%%%%%%%%%%@%%%%%%%%",
        "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
        "%%%%%%%%%@%%%%%%%%%%%%%%%%%%%%%%",
        "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
    ]

    palette_map: [
        "0000000000000000",   // NT rows 0-1: HUD
        "0000000000000000",   // NT rows 2-11: sky, clouds, title text
        "0000000000000000",
        "0000000000000000",
        "0000000000000000",
        "0000000000000000",
        "0000000000000000",   // NT rows 12-13: sky
        "1111111111111111",   // NT rows 14-15: brick platforms
        "0000000000000000",   // NT rows 16-17: sky
        "2222222222222222",   // NT rows 18-21: hills and bushes
        "2222222222222222",
        "3333333333333333",   // NT rows 22-29: grass and dirt
        "3333333333333333",
        "3333333333333333",
        "3333333333333333",
        "3333333333333333"   // below the screen
    ]
}

// ── Audio ────────────────────────────────────────────────────
sfx Boing {
    duty: 2
    pitch: 0x30
    envelope: [12, 11, 10, 9, 7, 5, 2]
}

sfx Ding {
    duty: 2
    pitch: 0x20
    envelope: [14, 12, 8, 3]
}

sfx Stomp {
    duty: 1
    pitch: 0x90
    envelope: [15, 13, 10, 7, 4, 2]
}

sfx Bonk {
    duty: 0
    pitch: 0xC0
    envelope: [12, 9, 5, 2]
}

music Theme {
    duty: 2
    volume: 9
    repeat: true
    tempo: 10
    notes: [
        C4, E4, G4, C5, G4, E4,
        D4 15,
        rest 5,
        B3, E4, G4,
        C5 20,
        rest 10
    ]
}

// ── Gameplay constants ──────────────────────────────────────
// The hero stays at one screen x. `camera_x` is the world x at the
// left edge of the screen, so walking moves the camera. World and
// screen x are both u8, and the level loops every 256 pixels, so
// `world_x - camera_x` is a screen x with no special cases.
const HERO_X:      u8 = 80
const HERO_MID:    u8 = 88          // HERO_X + 8: the hero's centre
const FLOOR_Y:     u8 = 160         // hero / walker y on the grass (row 22 = y 176)
const PLAT_TOP:    u8 = 120         // row 15
const PLAT_Y:      u8 = 104         // hero y standing on a platform
const PLAT_BOTTOM: u8 = 128

const NUM_PLATS: u8 = 2
const PLAT_X: u8[2] = [48, 152]     // NT columns 6 and 19
const PLAT_W: u8[2] = [40, 24]      // five and three tiles

// A jump moves the hero up RISE[i] pixels on its i-th frame, 60 in
// all, so the feet clear PLAT_TOP from the grass. Falling moves
// FALL[i] pixels on the i-th frame and stays at the last entry.
const RISE_LEN: u8 = 16
const RISE: u8[16] = [6, 6, 6, 5, 5, 5, 4, 4, 4, 3, 3, 3, 2, 2, 1, 1]
const FALL_LAST: u8 = 15
const FALL: u8[16] = [0, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6]
const SHORT_HOP: u8 = 5             // releasing A after this many rise frames ends the rise
const BOUNCE_AT: u8 = 6             // a stomp restarts the rise here: a 27-pixel bounce

const NUM_WALKERS: u8 = 2
const WALKER_START: u8[2] = [176, 32]
const WALKER_ALIVE: u8 = 0
const WALKER_GONE:  u8 = 1
const SQUASH_TIME:  u8 = 30         // frames a stomped walker lies flat; counts down to WALKER_GONE

const NUM_COINS: u8 = 3
const COIN_X: u8[3] = [64, 120, 160]  // over the ? block, mid-air, over the second ? block
const COIN_Y: u8[3] = [96, 116, 96]

// A collected coin or a stomped walker comes back once its screen x
// wraps past this, at the right edge of the screen.
const RESPAWN_X: u8 = 248

const TITLE_FRAMES: u8 = 60
const AUTOPILOT_JUMPS: u8 = 2       // the demo stomps this many walkers, then walks into the next
const AUTO_JUMP_LO: u8 = 128        // the demo jumps when a walker's screen x is in
const AUTO_JUMP_SPAN: u8 = 4        //   [AUTO_JUMP_LO, AUTO_JUMP_LO + AUTO_JUMP_SPAN)
const MAX_SCORE: u8 = 99            // two HUD digits

// Title text, as tiles. `TILE_SKY` is a space.
const TITLE_LEN: u8 = 10
const TITLE_TEXT: u8[10] = [TILE_P, TILE_L, TILE_A, TILE_T, TILE_F,
                            TILE_DIGIT_0, TILE_R, TILE_M, TILE_E, TILE_R]   // PLATFORMER
const PROMPT_LEN: u8 = 11
const PROMPT_TEXT: u8[11] = [TILE_P, TILE_R, TILE_E, TILE_S, TILE_S, TILE_SKY,
                             TILE_S, TILE_T, TILE_A, TILE_R, TILE_T]         // PRESS START
const TITLE_COL:  u8 = 11
const TITLE_ROW:  u8 = 8
const PROMPT_COL: u8 = 10
const PROMPT_ROW: u8 = 11

// GAME OVER, as sprites. Eight letters is the per-scanline limit, so
// nothing else may share their rows. `TILE_SKY` is a space.
const OVER_LEN: u8 = 9
const OVER_TEXT: u8[9] = [TILE_G, TILE_A, TILE_M, TILE_E, TILE_SKY,
                          TILE_DIGIT_0, TILE_V, TILE_E, TILE_R]               // GAME OVER
const OVER_X: u8 = 92
const OVER_Y: u8 = 88

// ── Game state ──────────────────────────────────────────────
// Title, Playing, and GameOver all draw the level, so the level's
// state is global. Playing writes it; the other two only draw it.
var frame_tick: u8 = 0
var score:      u8 = 0      // coins plus stomps this game
var lives:      u8 = 3      // GameOver spends one; Title refills
var demo:       u8 = 0      // 1 while the autopilot plays; Start clears it

var camera_x: u8 = 0
var hero_y:   u8 = FLOOR_Y
var on_ground: u8 = 1
var rise_i:   u8 = RISE_LEN // index into RISE; RISE_LEN when not rising
var fall_i:   u8 = 0        // index into FALL while airborne
var facing:   u8 = 0        // 0 right, 1 left
var walking:  u8 = 0        // 1 on frames the hero moved
var dead:     u8 = 0

var walker_x:  u8[2]        // world x
var walker_st: u8[2]        // WALKER_ALIVE, WALKER_GONE, or a squash countdown
var coin_got:  u8[3]        // 1 once collected, until it respawns

// HUD shadow copies. The map paints "00" and "3", so these start at
// the values on screen and the first frame queues no writes.
var last_score: u8 = 0
var last_lives: u8 = 3

// ── Level ───────────────────────────────────────────────────

fun reset_level() {
    camera_x = 0
    hero_y = FLOOR_Y
    on_ground = 1
    rise_i = RISE_LEN
    fall_i = 0
    facing = 0
    walking = 0
    dead = 0
    for i in 0..NUM_WALKERS {
        walker_x[i] = WALKER_START[i]
        walker_st[i] = WALKER_ALIVE
    }
    for i in 0..NUM_COINS {
        coin_got[i] = 0
    }
}

fun add_point() {
    if score < MAX_SCORE {
        score += 1
    }
}

// 1 when the hero's feet are over a brick platform. The feet span
// HERO_MID ± 4, so a platform holds the hero until the centre is
// four pixels past its end.
fun over_platform() -> u8 {
    var feet: u8 = camera_x + HERO_MID + 4
    for i in 0..NUM_PLATS {
        if feet - PLAT_X[i] < PLAT_W[i] + 8 {
            return 1
        }
    }
    return 0
}

// ── Hero ─────────────────────────────────────────────────────

fun try_jump() {
    if on_ground == 1 {
        on_ground = 0
        rise_i = 0
        play Boing
    }
}

fun land(y: u8) {
    hero_y = y
    on_ground = 1
    fall_i = 0
}

// One frame of vertical motion: rise along RISE, fall along FALL,
// land on the floor or the top of a platform, bump the underside of
// one, and fall off the end of one.
fun step_hero() {
    if rise_i < RISE_LEN {
        var up_y: u8 = hero_y - RISE[rise_i]
        rise_i += 1
        if hero_y >= PLAT_BOTTOM and up_y < PLAT_BOTTOM {
            if over_platform() == 1 {
                up_y = PLAT_BOTTOM
                rise_i = RISE_LEN
                play Bonk
            }
        }
        hero_y = up_y
        return
    }
    if on_ground == 1 {
        if hero_y == PLAT_Y {
            if over_platform() == 0 {
                on_ground = 0
                fall_i = 0
            }
        }
        return
    }
    var down_y: u8 = hero_y + FALL[fall_i]
    if fall_i < FALL_LAST {
        fall_i += 1
    }
    if hero_y <= PLAT_Y and down_y >= PLAT_Y {
        if over_platform() == 1 {
            land(PLAT_Y)
            return
        }
    }
    if down_y >= FLOOR_Y {
        land(FLOOR_Y)
        return
    }
    hero_y = down_y
}

fun human_input() {
    var speed: u8 = 1
    if button.b {
        speed = 2
    }
    walking = 0
    if button.right {
        camera_x += speed
        facing = 0
        walking = 1
    } else if button.left {
        camera_x -= speed
        facing = 1
        walking = 1
    }
    if p1.button.a.pressed {
        try_jump()
    }
    // Letting go of A cuts the rise short, after a minimum hop.
    if rise_i < RISE_LEN and rise_i >= SHORT_HOP {
        if not button.a {
            rise_i = RISE_LEN
        }
    }
}

// The attract-mode demo walks right and hops each walker it meets
// until `jumps_left` runs out.
fun autopilot(jumps_left: u8) -> u8 {
    camera_x += 1
    facing = 0
    walking = 1
    if jumps_left == 0 or on_ground == 0 {
        return jumps_left
    }
    for i in 0..NUM_WALKERS {
        if walker_st[i] == WALKER_ALIVE {
            var wx: u8 = walker_x[i] - camera_x
            if wx - AUTO_JUMP_LO < AUTO_JUMP_SPAN {
                try_jump()
                return jumps_left - 1
            }
        }
    }
    return jumps_left
}

// The hero's body tile for this frame. Each body's right half is the
// next tile.
fun hero_body() -> u8 {
    if on_ground == 0 {
        return TILE_HERO_JUMP_L
    }
    if walking == 1 and (frame_tick & 8) != 0 {
        return TILE_HERO_STEP_L
    }
    return TILE_HERO_STAND_L
}

// A flipped sprite mirrors each tile in place, so facing left also
// swaps the left and right columns.
fun draw_hero() {
    var body: u8 = hero_body()
    if facing == 0 {
        draw Tileset at: (HERO_X,     hero_y)     frame: TILE_HERO_HL
        draw Tileset at: (HERO_X + 8, hero_y)     frame: TILE_HERO_HR
        draw Tileset at: (HERO_X,     hero_y + 8) frame: body
        draw Tileset at: (HERO_X + 8, hero_y + 8) frame: body + 1
    } else {
        draw Tileset at: (HERO_X,     hero_y)     frame: TILE_HERO_HR attr: FLIP_H
        draw Tileset at: (HERO_X + 8, hero_y)     frame: TILE_HERO_HL attr: FLIP_H
        draw Tileset at: (HERO_X,     hero_y + 8) frame: body + 1     attr: FLIP_H
        draw Tileset at: (HERO_X + 8, hero_y + 8) frame: body         attr: FLIP_H
    }
}

// Upside down: the jump body on top, the head below, both flipped
// vertically.
fun draw_dead_hero() {
    draw Tileset at: (HERO_X,     hero_y)     frame: TILE_HERO_JUMP_L attr: FLIP_V
    draw Tileset at: (HERO_X + 8, hero_y)     frame: TILE_HERO_JUMP_R attr: FLIP_V
    draw Tileset at: (HERO_X,     hero_y + 8) frame: TILE_HERO_HL     attr: FLIP_V
    draw Tileset at: (HERO_X + 8, hero_y + 8) frame: TILE_HERO_HR     attr: FLIP_V
}

// ── Walkers and coins ───────────────────────────────────────

// Walkers creep left half a pixel a frame, even while gone, so a
// respawned walker turns up where it would have been.
fun step_walkers() {
    for i in 0..NUM_WALKERS {
        if (frame_tick & 1) == 0 {
            walker_x[i] -= 1
        }
        var st: u8 = walker_st[i]
        if st > WALKER_GONE {
            walker_st[i] = st - 1
        } else if st == WALKER_GONE {
            if walker_x[i] - camera_x >= RESPAWN_X {
                walker_st[i] = WALKER_ALIVE
            }
        }
    }
}

// Touching a walker from above squashes it and bounces the hero;
// touching it any other way kills the hero. A walker's box is its
// 12 middle columns and its bottom 12 rows; the hero's is its 12
// middle columns and bottom 14 rows. They overlap when the walker's
// screen x is in [69, 92) and the hero's y is above 148.
fun hit_walkers() {
    for i in 0..NUM_WALKERS {
        if walker_st[i] == WALKER_ALIVE and dead == 0 {
            var wx: u8 = walker_x[i] - camera_x
            if wx - 69 < 23 and hero_y > 148 {
                if rise_i == RISE_LEN and on_ground == 0 {
                    walker_st[i] = SQUASH_TIME
                    add_point()
                    fall_i = 0
                    rise_i = BOUNCE_AT
                    if demo == 0 and button.a {
                        rise_i = 0
                    }
                    play Stomp
                } else {
                    dead = 1
                    play hit
                }
            }
        }
    }
}

// The hero touches a coin when the coin's screen x is in [76, 93)
// and the hero's top is within 15 pixels above to 12 below the
// coin's top.
fun collect_coins() {
    for i in 0..NUM_COINS {
        var cx: u8 = COIN_X[i] - camera_x
        if coin_got[i] == 0 {
            if cx - 76 < 17 and hero_y - (COIN_Y[i] - 15) < 28 {
                coin_got[i] = 1
                add_point()
                play Ding
            }
        } else if cx >= RESPAWN_X {
            coin_got[i] = 0
        }
    }
}

// A walker waddles by drawing itself mirrored every 16 frames. A
// mirrored metasprite swaps its left and right columns too.
fun draw_walker(wx: u8, st: u8) {
    if st == WALKER_ALIVE {
        if (frame_tick & 16) == 0 {
            draw Tileset at: (wx,     FLOOR_Y)     frame: TILE_WALKER_TL attr: ATTR_WALKER
            draw Tileset at: (wx + 8, FLOOR_Y)     frame: TILE_WALKER_TR attr: ATTR_WALKER
            draw Tileset at: (wx,     FLOOR_Y + 8) frame: TILE_WALKER_BL attr: ATTR_WALKER
            draw Tileset at: (wx + 8, FLOOR_Y + 8) frame: TILE_WALKER_BR attr: ATTR_WALKER
        } else {
            draw Tileset at: (wx,     FLOOR_Y)     frame: TILE_WALKER_TR attr: ATTR_WALKER | FLIP_H
            draw Tileset at: (wx + 8, FLOOR_Y)     frame: TILE_WALKER_TL attr: ATTR_WALKER | FLIP_H
            draw Tileset at: (wx,     FLOOR_Y + 8) frame: TILE_WALKER_BR attr: ATTR_WALKER | FLIP_H
            draw Tileset at: (wx + 8, FLOOR_Y + 8) frame: TILE_WALKER_BL attr: ATTR_WALKER | FLIP_H
        }
    } else if st > WALKER_GONE {
        draw Tileset at: (wx,     FLOOR_Y + 8) frame: TILE_SQUASH attr: ATTR_WALKER
        draw Tileset at: (wx + 8, FLOOR_Y + 8) frame: TILE_SQUASH attr: ATTR_WALKER | FLIP_H
    }
}

// A coin spins through full, thin, edge-on, and thin mirrored.
fun draw_coin(cx: u8, cy: u8) {
    var turn: u8 = (frame_tick >> 3) & 3
    if turn == 0 {
        draw Tileset at: (cx, cy)     frame: TILE_COIN_FULL_T attr: ATTR_COIN
        draw Tileset at: (cx, cy + 8) frame: TILE_COIN_FULL_B attr: ATTR_COIN
    } else if turn == 2 {
        draw Tileset at: (cx, cy)     frame: TILE_COIN_EDGE_T attr: ATTR_COIN
        draw Tileset at: (cx, cy + 8) frame: TILE_COIN_EDGE_B attr: ATTR_COIN
    } else if turn == 1 {
        draw Tileset at: (cx, cy)     frame: TILE_COIN_THIN_T attr: ATTR_COIN
        draw Tileset at: (cx, cy + 8) frame: TILE_COIN_THIN_B attr: ATTR_COIN
    } else {
        draw Tileset at: (cx, cy)     frame: TILE_COIN_THIN_T attr: ATTR_COIN | FLIP_H
        draw Tileset at: (cx, cy + 8) frame: TILE_COIN_THIN_B attr: ATTR_COIN | FLIP_H
    }
}

fun draw_world() {
    for i in 0..NUM_WALKERS {
        draw_walker(walker_x[i] - camera_x, walker_st[i])
    }
    for i in 0..NUM_COINS {
        if coin_got[i] == 0 {
            draw_coin(COIN_X[i] - camera_x, COIN_Y[i])
        }
    }
}

// ── HUD ─────────────────────────────────────────────────────
// The HUD row is background tiles. Each frame draws sprite 0 first,
// so it takes OAM slot 0, then the coin and heart icons. The digits
// are repainted with `nt_set` only when the score or lives change.
//
// `sprite_0_split(camera_x, 0)` at the end of each frame waits for
// the sprite-0 hit on scanline 16, the rule under the HUD, and then
// scrolls the rest of the frame, so the HUD stays put while the level
// moves.
fun draw_hud() {
    draw Tileset at: (248, 15) frame: TILE_SPRITE0_ANCHOR
    draw Tileset at: (24,  7) frame: TILE_COIN_ICON attr: ATTR_COIN
    draw Tileset at: (200, 7) frame: TILE_HEART     attr: ATTR_TEXT

    if score != last_score {
        last_score = score
        nt_set(4, 1, TILE_DIGIT_0 + (score / 10))
        nt_set(5, 1, TILE_DIGIT_0 + (score % 10))
    }
    if lives != last_lives {
        last_lives = lives
        nt_set(26, 1, TILE_DIGIT_0 + lives)
    }
}

fun draw_scene() {
    draw_hud()
    draw_hero()
    draw_world()
}

// ── Title text ──────────────────────────────────────────────

fun show_title() {
    for i in 0..TITLE_LEN {
        nt_set(TITLE_COL + i, TITLE_ROW, TITLE_TEXT[i])
    }
}

fun show_prompt() {
    for i in 0..PROMPT_LEN {
        nt_set(PROMPT_COL + i, PROMPT_ROW, PROMPT_TEXT[i])
    }
}

fun hide_prompt() {
    nt_fill_h(PROMPT_COL, PROMPT_ROW, PROMPT_LEN, TILE_SKY)
}

// ── States ──────────────────────────────────────────────────

state Title {
    var title_t: u8 = 0

    on enter {
        lives = 3
        score = 0
        reset_level()
        show_title()
        show_prompt()
        start_music Theme
    }

    on exit {
        nt_fill_h(TITLE_COL, TITLE_ROW, TITLE_LEN, TILE_SKY)
        hide_prompt()
    }

    on frame {
        frame_tick += 1
        title_t += 1
        // Blink PRESS START: off for 16 frames of every 48.
        if title_t % 48 == 32 {
            hide_prompt()
        } else if title_t % 48 == 0 {
            show_prompt()
        }

        draw_scene()
        sprite_0_split(0, 0)

        if p1.button.start.pressed {
            demo = 0
            transition Playing
        }
        if title_t >= TITLE_FRAMES {
            demo = 1
            transition Playing
        }
    }
}

state Playing {
    var jumps_left: u8 = AUTOPILOT_JUMPS

    on enter {
        reset_level()
        start_music Theme
    }

    on frame {
        frame_tick += 1

        if demo == 1 {
            // Start during the demo begins a real game.
            if p1.button.start.pressed {
                demo = 0
                lives = 3
                score = 0
                transition Playing
            }
            jumps_left = autopilot(jumps_left)
        } else {
            human_input()
        }

        step_hero()
        step_walkers()
        collect_coins()
        hit_walkers()

        if dead == 0 {
            draw_scene()
        } else {
            draw_hud()
            draw_dead_hero()
            draw_world()
        }

        // The NMI's VRAM drain leaves the scroll at (0, 0), so the
        // HUD draws unscrolled. A `scroll()` here would land
        // partway down the screen, below the split.
        sprite_0_split(camera_x, 0)

        if dead == 1 {
            transition GameOver
        }
    }
}

// The hero hops and falls off the screen while the level freezes.
// With lives left, play resumes; on the last life, GAME OVER shows
// and the title follows.
state GameOver {
    var over_t: u8 = 0

    on enter {
        if lives > 0 {
            lives -= 1
        }
        stop_music
    }

    on frame {
        over_t += 1
        if over_t > 12 {
            if over_t <= 24 {
                hero_y -= 3
            } else if hero_y < 232 {
                hero_y += 4
            }
        }

        draw_hud()
        if hero_y < 232 {
            draw_dead_hero()
        }
        draw_world()
        if lives == 0 {
            for i in 0..OVER_LEN {
                if OVER_TEXT[i] != TILE_SKY {
                    draw Tileset at: (OVER_X + i * 8, OVER_Y) frame: OVER_TEXT[i] attr: ATTR_TEXT
                }
            }
        }

        sprite_0_split(camera_x, 0)

        var done: u8 = 0
        if lives == 0 {
            if over_t >= 180 {
                done = 1
            }
        } else if over_t >= 60 {
            done = 1
        }
        if over_t > 30 and p1.button.start.pressed {
            done = 1
        }
        if done == 1 {
            if lives == 0 {
                transition Title
            } else {
                transition Playing
            }
        }
    }
}

start Title
