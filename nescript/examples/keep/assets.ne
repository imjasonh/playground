metasprite Gun {
    sprite: GunArt
    dx: [0, 8, 0, 8]
    dy: [0, 0, 8, 8]
    frame: [0, 1, 2, 3]
}

sprite GuardArt {
    pixels: [
        ".....%%%%.......",
        "...%%####%%.....",
        "..%########%....",
        "..%##@##@##%....",
        "..%########%....",
        "...%######%.....",
