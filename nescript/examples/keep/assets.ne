// keep/assets.ne: wall tiles, glyphs, and actors.
//
// Background colours, in bg0: index 1 brown, index 2 orange,
// index 3 tan. Index 0 is the black backdrop, used as the ceiling
// and as the gaps in the exit gate.
//
// Glyph ink is index 2. On the guard palette that is dark red,
// which reads on the gray frame, so the ammo digits use it.
// On the heart palette it is white, which reads on the black
// window, so the title and the end text use that. Guards use
// sp0 (peach, dk_red, white). Hearts and the muzzle flash use
// sp2 (red, white, yellow). The gun uses sp1.

sprite Tileset {
    pixels: [
        // blank / ceiling
        "........",
        "........",
        "........",
        "........",
        "........",
        "........",
        "........",
        "........",
        // floor
        "########",
        "###%####",
        "########",
        "#####%##",
        "########",
        "##%#####",
        "########",
        "####%###",
        // brick, near
        "@@@##@@@",
        "@@@##@@@",
        "########",
        "##@@@##@",
        "##@@@##@",
        "########",
        "@@@##@@@",
        "@@@##@@@",
        // brick, far / shaded
        "###%%###",
        "###%%###",
        "%%%%%%%%",
        "%%###%%#",
        "%%###%%#",
        "%%%%%%%%",
        "###%%###",
        "###%%###",
        // stone, near
        "@@@@#@@@",
        "@@@#@@@@",
        "###@@@@#",
        "@@@@#@@@",
        "@@@#@@@@",
        "##@@@@##",
        "@@@@#@@@",
        "@@@#@@@@",
        // stone, shaded
        "####%###",
        "###%####",
        "%%%####%",
        "####%###",
        "###%####",
        "%%####%%",
        "####%###",
        "###%####",
        // door
        "##@##@##",
        "##@##@##",
        "##@##@##",
        "########",
        "##@##@##",
        "##@##@##",
        "##@##@##",
        "##@##@##",
        // exit gate
        "@.@.@.@.",
        ".@.@.@.@",
        "@.@.@.@.",
        ".@.@.@.@",
        "@.@.@.@.",
        ".@.@.@.@",
        "@.@.@.@.",
        ".@.@.@.@"
    ]
}

