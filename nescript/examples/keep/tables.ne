// keep/tables.ne: angle steps and wall height.
//
// 64 angles. STEP_* is the per-iteration ray delta, at most 8
// units. MOVE_* is the player step, at most 4. Negative values
// are stored as two's complement so a u8 add wraps the right way.
// WALL_H[steps] is the wall's half-height in tiles. COL_OFF is the
// ray's angle relative to the player, one entry per view column,
// covering a quarter turn (about 90 degrees).

const STEP_X: u8[64] = [
    8, 8, 8, 8, 7, 7, 7, 6, 6, 5, 4, 4, 3, 2, 2, 1,
    0, 255, 254, 254, 253, 252, 252, 251, 250, 250, 249, 249, 249, 248, 248, 248,
    248, 248, 248, 248, 249, 249, 249, 250, 250, 251, 252, 252, 253, 254, 254, 255,
    0, 1, 2, 2, 3, 4, 4, 5, 6, 6, 7, 7, 7, 8, 8, 8
]

