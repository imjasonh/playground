// keep/backgrounds.ne: the one nametable.
//
// The window from column 8, row 4 is 16 by 16 blank tiles. Play
// overwrites that window with the raycast. The brick frame around
// it stays put. Columns 0 and 31 stay blank because TVs crop them.
//
// palette_map cells are 16 pixels. The window lines up with cells
// 4 through 11 and rows 2 through 9, so distance shading is not
// required of the attribute grid: the window is one palette and
// the frame is another.

background Playfield {
    legend {
        ".": 1
        "#": 3
    }
    map: [
        "................................",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".#######................#######.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        ".##############################.",
        "................................"
    ]
    palette_map: [
        "1111111111111111",
        "1111111111111111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111000000001111",
        "1111111111111111",
        "1111111111111111",
        "1111111111111111",
        "1111111111111111",
        "1111111111111111"
    ]
}
