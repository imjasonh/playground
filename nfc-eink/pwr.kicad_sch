  (text "VOUT_EH -- D1 -- R1 -- VSTORE -- U2 boost --> +3V3" (at 15 22 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 1c37014e-ef1e-477d-8f41-788e6bade51a))
  (text "Vout = 0.595 x (1 + 453k/100k) = 3.29 V" (at 175 145 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid a78f2b54-0ff0-42cd-9e18-4bbad6789923))
  (text "Hold off the EPD rail until VSTORE_DIV says the tank is ready." (at 260 35 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid a1d43bb5-c0f6-414d-a9a2-71a404aa6189))
  (text "TCM809 is push-pull. No capacitor on NRST. R12 holds the pin low after VDD falls below 1 V." (at 175 185 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 0e63e085-ad4e-4f34-9d7c-31243a3d2cc9))
  (text "R11 keeps TPS22917 OFF while PB0 is analog after reset." (at 150 230 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 71ab02e8-87e3-4b0e-9119-1e1c2573ee80))
