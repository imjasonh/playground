module(name = "ci_substrate")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# The checksums are listed so the SDK download does not need go.dev, which
# egress-restricted hosts (the kind e2e's) cannot reach.
go_sdk.download(
    sdks = {
        "darwin_amd64": ("go1.27.0.darwin-amd64.tar.gz", "d3314e25496e4381d71a5c51d2907e7af655d199f6780b549f015bd85fef4986"),
        "darwin_arm64": ("go1.27.0.darwin-arm64.tar.gz", "90493b3bbd5e10f91d12153198bf1994fd756399b4fec93b49b0c6e2acdeeb3e"),
        "linux_amd64": ("go1.27.0.linux-amd64.tar.gz", "675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685"),
        "linux_arm64": ("go1.27.0.linux-arm64.tar.gz", "51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda"),
    },
    version = "1.27.0",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Modules check in their generated .pb.go files. Building those instead of
# the .proto sources keeps protoc, a C++ tool, out of the build: the cluster's
# runners have no C toolchain.
go_deps.gazelle_default_attributes(
    directives = ["gazelle:proto disable"],
)

# remote-apis checks in BUILD files that load proto rules it cannot see as a
# Go module, so Gazelle replaces them.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable"],
    path = "github.com/bazelbuild/remote-apis",
)
use_repo(go_deps, "com_github_bazelbuild_remote_apis", "com_github_chainguard_dev_clog", "com_github_container_storage_interface_spec", "com_github_google_uuid", "com_github_hanwen_go_fuse_v2", "com_github_sethvargo_go_envconfig", "com_google_cloud_go_longrunning", "dev_ate_go_substrate", "io_k8s_sigs_yaml", "io_opentelemetry_go_contrib_instrumentation_google_golang_org_grpc_otelgrpc", "io_opentelemetry_go_contrib_instrumentation_runtime", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "org_golang_google_genproto_googleapis_bytestream", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_sync")
