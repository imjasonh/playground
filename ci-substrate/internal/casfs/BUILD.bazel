load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "casfs",
    srcs = [
        "casfs.go",
        "metrics.go",
    ],
    importpath = "github.com/imjasonh/playground/ci-substrate/internal/casfs",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/digest",
        "//internal/telemetry",
        "//internal/tree",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@com_github_hanwen_go_fuse_v2//fs",
        "@com_github_hanwen_go_fuse_v2//fuse",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

go_test(
    name = "casfs_test",
    srcs = ["casfs_test.go"],
    # fusermount cannot mount inside Bazel's sandbox, and the test's /dev/fuse
    # check sees the device there and does not skip.
    tags = ["no-sandbox"],
    deps = [
        ":casfs",
        "//internal/digest",
        "//internal/tree",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
    ],
)
