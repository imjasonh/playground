load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tree",
    srcs = ["tree.go"],
    importpath = "github.com/imjasonh/playground/ci-substrate/internal/tree",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/digest",
        "//internal/tenant",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "tree_test",
    srcs = ["tree_test.go"],
    embed = [":tree"],
    deps = [
        "//internal/digest",
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
    ],
)
