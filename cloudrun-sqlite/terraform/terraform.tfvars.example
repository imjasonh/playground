# Copy to terraform.tfvars (gitignored) and fill in values.
project_id = "your-gcp-project"
region     = "us-central1"

# Acknowledge writes only after they are in Cloud Storage.
# durable = true

# Run compaction and snapshots between requests (instance-based billing).
# cpu_always_allocated = false

# On linux/amd64 with gcc installed, skip zig:
# cgo_cc = "gcc"

# GitHub repository allowed to apply this stack from main. This creates
# the Workload Identity pool. The directory name and `name` must match.
# github_repository = "imjasonh/playground"
#
# State bucket, created once in this project and passed to init:
#   terraform init -backend-config="bucket=BUCKET"
