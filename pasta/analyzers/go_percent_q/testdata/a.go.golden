package a

import (
	"fmt"
	"io"
)

func bad(v string) {
	fmt.Printf("value %q\n", v)         // want "use %q"
	_ = fmt.Sprintf("value %q", v)      // want "use %q"
	_ = fmt.Errorf("missing %q", v)     // want "use %q"
	_ = fmt.Sprintf(`value %q`, v)        // want "use %q"
	fmt.Fprintf(io.Discard, "le=%q", v) // want "use %q"
	_ = fmt.Appendf(nil, "value %q", v) // want "use %q"
	fmt.Fprintf(io.Discard, `le=%q`, v)       // want "use %q"
	_ = fmt.Sprintf("a %q b %q", v, v) // want "use %q"
	_ = fmt.Sprintf(`a %q b %q`, v, v)     // want "use %q"
}

func ok(v string) string {
	fmt.Printf("value %q\n", v)
	fmt.Printf("%s\n", v)
	fmt.Fprintf(io.Discard, "le=%q", v)
	fmt.Fprintf(io.Discard, "%s=%q", "name", v)
	return fmt.Sprintf("%s", v)
}
