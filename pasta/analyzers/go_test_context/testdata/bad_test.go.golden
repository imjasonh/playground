package a

import (
	"context"
	"testing"
)

func TestBad(t *testing.T) {
	_ = t.Context() // want "use t.Context() instead of context.Background()"
	_ = t.Context()       // want "use t.Context() instead of context.TODO()"
	ctx, cancel := context.WithCancel(t.Context()) // want "use t.Context() instead of context.Background()"
	defer cancel()
	_ = ctx
}
